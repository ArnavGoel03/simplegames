{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The studio site. Named for what it is, and the name is also the address:
  // this Worker answers on glasstablegames.goelhome.workers.dev, which is what
  // `src/lib/brand.ts` resolves to and therefore what every canonical tag, OG
  // image and sitemap entry on the site points at.
  "name": "glasstablegames",
  // The studio's own address, at the apex rather than under a label: it is
  // the domain the game sites are subdomains of. `custom_domain` has
  // Cloudflare create the record, issue the certificate and register the
  // route together on deploy. The workers.dev name keeps answering too, which
  // is what makes this safe to roll out while the old address is still linked.
  "routes": [
    { "pattern": "glasstablegames.com", "custom_domain": true },
    // www is attached so it reaches this Worker at all. Unattached it
    // answered 530, which is Cloudflare saying it has a name and nowhere to
    // send it. What it does once it arrives is a permanent redirect, in
    // next.config.ts, so there is one address for this site rather than two
    // serving the same pages.
    { "pattern": "www.glasstablegames.com", "custom_domain": true }
  ],
  // Built by `opennextjs-cloudflare build`, never by hand. It wraps the Next
  // server output in a Worker entrypoint and writes the client bundle out to
  // assets beside it.
  "main": ".open-next/worker.js",
  // The same date the game sites pin. Two sites out of one studio drifting apart
  // on the runtime's version is two runtimes to reason about for no gain.
  "compatibility_date": "2026-08-09",
  // Required by the adapter: Next's server half reaches for Node builtins even
  // when the application code does not.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
  // No secrets and no bindings, which is the whole shape of this site: five
  // pages, no database, no accounts, no analytics, nothing to leak.
}
