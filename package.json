{
  "name": "glass-table-games",
  "version": "0.5.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:build": "npm run assets && node tools/cf.mjs build",
    "cf:preview": "node tools/cf.mjs preview",
    "cf:deploy": "node tools/cf.mjs deploy",
    "indexnow": "node tools/indexnow.mjs",
    "verify:live": "node tools/verify-live.mjs && node tools/sync-catalogue.mjs --check",
    "sync:catalogue": "node tools/sync-catalogue.mjs",
    "prebuild": "npm run assets && node tools/generate-worker.mjs",
    "predev": "npm run assets && node tools/generate-worker.mjs",
    "pretest": "node tools/generate-worker.mjs",
    "assets": "node tools/generate-icons.mjs",
    "verify:visual": "node tools/verify-visual.mjs",
    "verify:toolchain": "node tools/verify-toolchain.mjs",
    "gate": "npm run verify:toolchain && npm run typecheck && npm run lint && npm test && npm run test:release",
    "test:release": "node --test tools/quality/*.node-spec.mjs",
    "quality": "node tools/quality-gate.mjs",
    "cf:upload": "node tools/cf.mjs upload",
    "release:receipt": "node tools/release-receipt.mjs",
    "postinstall": "npm ci --prefix tools/eslint-compat --ignore-scripts --no-audit --no-fund"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.145.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true,
    "workerd": true
  }
}
