{
  "name": "glass-table-games",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:build": "npm run assets && node tools/cf.mjs build",
    "cf:preview": "node tools/cf.mjs preview",
    "cf:deploy": "node tools/cf.mjs deploy",
    "indexnow": "node tools/indexnow.mjs",
    "verify:live": "node tools/verify-live.mjs && node tools/sync-catalogue.mjs --check",
    "sync:catalogue": "node tools/sync-catalogue.mjs",
    "prebuild": "npm run assets && node tools/generate-worker.mjs",
    "predev": "npm run assets && node tools/generate-worker.mjs",
    "pretest": "node tools/generate-worker.mjs",
    "assets": "node tools/generate-icons.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.0",
    "sharp": "^0.35.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
